# ============================================================
# CUJAE Cuadro de Mando - variables de entorno
# NUNCA commitear .env real (ver .gitignore)
#
# Como usarlo:
#   1. Copia este archivo:  copy .env.example .env
#   2. Genera un secreto:   openssl rand -hex 32   (o python -c "import secrets; print(secrets.token_hex(32))")
#   3. Pon tu password de PostgreSQL en POSTGRES_PASSWORD
# ============================================================

# --- Docker Compose (db + backend) ---
# Requeridos: compose falla al arrancar si faltan.
POSTGRES_USER=cujae
POSTGRES_PASSWORD=CAMBIA-ESTA-CLAVE
POSTGRES_DB=cujae_tablero
JWT_SECRET_KEY=generar-con-openssl-rand-hex-32

# --- Backend (pydantic-settings) ---
# En docker compose se generan a partir de las variables de arriba.
DATABASE_URL=postgresql+asyncpg://cujae:CAMBIA-ESTA-CLAVE@localhost:5432/cujae_tablero
DATABASE_URL_SYNC=postgresql+psycopg2://cujae:CAMBIA-ESTA-CLAVE@localhost:5432/cujae_tablero
REDIS_URL=redis://localhost:6379/0
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
LDAP_URL=ldap://ldap.cujae.edu.cu
LDAP_BASE_DN=dc=cujae,dc=edu,dc=cu
ENV=dev

# Seed del administrador inicial (se usa solo en la primera migracion)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# --- LLM externo (freellmpool) - opcional, proveedores keyless si estan vacios ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
PROVEEDOR_IA=groq

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
